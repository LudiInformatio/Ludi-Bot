# ====================================================
# LUDI INFORMATIO | ENVIRONMENT VARIABLES TEMPLATE
# ====================================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git!

# ====================================================
# REQUIRED (Core functionality)
# ====================================================

# The-Odds-API (Game lines, player props)
# Get key: https://the-odds-api.com/
# Pricing: Free (500 credits) or $30/mo (20K credits)
ODDS_API_KEY=your_key_here

# Tank01 (Rosters, injuries, box scores)
# Get key: https://rapidapi.com/tank01/api/tank01-fantasy-stats
# Pricing: Free (1K/mo) or $10/mo (1K/day)
TANK01_KEY=your_key_here

# ====================================================
# OPTIONAL (New paid APIs - add when ready)
# ====================================================

# API-Sports (Historical data, backtesting)
# Get key: https://api-sports.io/
# Pricing: $25/mo for Pro tier
APISPORTS_KEY=

# BallDontLie (Props validation, injuries, play-by-play)
# Get key: https://app.balldontlie.io/
# Pricing: GOAT tier $39.99/mo (600 req/min)
BALLDONTLIE_KEY=
BDL_TIER=goat

# Gemini AI (Ask Ludi chatbot - Week 7)
# Get key: https://aistudio.google.com/
# Pricing: Pay-as-you-go (~$5-10/mo)
GEMINI_API_KEY=

# Perplexity API (Research queries)
# Get key: https://www.perplexity.ai/
# Pricing: $10/mo (Pro) or $20/mo (Pro+)
PERPLEXITY_API_KEY=

# ====================================================
# UTILITIES (Optional features)
# ====================================================

# Google Custom Search (The Yak news search)
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_CX=

# Telegram Bot (Morning briefing alerts)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# SportsGameOdds (Alternate prop source)
SGO_API_KEY=

# ====================================================
# PRODUCTION FLAGS (set by workflows, override locally if needed)
# ====================================================
IS_PRODUCTION=false
DEBUG_LOG=false

# --- Claude API (Phase 8 AI Integration) ---
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here  # From Claude Max plan (preferred)
# ANTHROPIC_API_KEY=your-key-here              # Fallback if no OAuth token
