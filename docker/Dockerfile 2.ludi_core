# LUDI CORE - The Fortress
# Base Image: Official Python 3.11 (Slim version for size/security)
FROM python:3.11-slim-bookworm

# 1. Environment Configuration
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 2. Install System Dependencies
# We need these for:
# - git: version control
# - curl: healthchecks
# - sqlite3: database interaction
# - Playwright dependencies (libraries required to run headless browsers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    sqlite3 \
    libwoff1 \
    libopus0 \
    libwebp7 \
    libwebpdemux2 \
    libenchant-2-2 \
    libgudev-1.0-0 \
    libsecret-1-0 \
    libhyphen0 \
    libgdk-pixbuf2.0-0 \
    libegl1 \
    libnotify4 \
    libxslt1.1 \
    libevent-2.1-7 \
    libgles2 \
    libvpx7 \
    libxcomposite1 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libepoxy0 \
    libgtk-3-0 \
    libharfbuzz-icu0 \
    gstreamer1.0-libav \
    libnss3 \
    libxss1 \
    libasound2 \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# 3. Create Non-Root User "ludi"
# Security Best Practice: Never run as root if you don't have to.
RUN groupadd -g 1001 ludi && \
    useradd -m -u 1001 -g ludi ludi

# 4. Set Up Application Directory
WORKDIR /app

# 5. Install Python Dependencies
# We copy requirements first to leverage Docker layer caching
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install pip-audit && \
    pip install -r requirements.txt && \
    pip install playwright && \
    playwright install chromium --with-deps && \
    pip-audit --desc on -r requirements.txt

# 6. Set Ownership & Switch User
RUN chown -R ludi:ludi /app
USER ludi

# 7. Default Command
CMD ["python3", "--version"]
